# Plantilla de producción. Copia los valores en los SECRETOS del proveedor de
# hosting (o en un .env que nunca se sube a Git). Ver docs/PRODUCTION_LAUNCH.md.
NODE_ENV=production
PORT=3000
# Detrás del proxy HTTPS del proveedor (Railway, Render, Fly, Nginx...).
TRUST_PROXY=true
# Cabecera con la IP real del cliente que el proxy sobrescribe (Railway: x-real-ip).
CLIENT_IP_HEADER=
# Dominio HTTPS exacto donde se abre la aplicación (sin barra final).
FRONTEND_URL=https://app.tudominio.com
# La misma API sirve el frontend compilado (un solo servicio).
SERVE_FRONTEND=true
# Volumen PERSISTENTE para fotos, QR, logos y comprobantes privados.
UPLOADS_DIR=/data/uploads

# PostgreSQL en Supabase, por el pooler en modo sesión (IPv4, puerto 5432).
# Usuario propio de la aplicación: lo crea el migrador, nunca postgres.
DATABASE_URL=postgresql://reservas_app.REF:CLAVE_APP@aws-N-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Cifra sin verificar el certificado. Para verificarlo, usa DATABASE_CA_CERT.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Días que se guardan los comprobantes de pago antes de borrarse (imagen y
# registro). Nunca se borran los de pagos pendientes de revisión.
PAYMENT_PROOF_RETENTION_DAYS=20

# Conexiones a la base por instancia. La suma de todas las instancias debe
# quedar bajo el "pool size" de Supabase en modo sesión (15 en el plan Micro):
# 10 con una instancia, 7 con dos.
DATABASE_POOL_MAX=10
# DATABASE_CA_CERT=

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_ALEATORIOS

# Barbería que atienden las rutas antiguas sin /t/:slug (enlaces previos de Empyrean).
DEFAULT_TENANT_SLUG=empyrean-studio
# Marca de los correos enviados fuera de una barbería.
PLATFORM_NAME=Reservas de barbería

# Migrador (npm run db:migrate / pre-deploy de Railway): conexión de ADMINISTRADOR.
# Crea el usuario de DATABASE_URL con permisos mínimos.
MIGRATION_DATABASE_URL=postgresql://postgres.REF:CLAVE_ADMIN@aws-N-REGION.pooler.supabase.com:5432/postgres
# Operadores de la plataforma (cuentas ya registradas), separados por coma.
PLATFORM_ADMIN_EMAILS=operador@tudominio.com

# Correo transaccional (recuperar contraseña y recordatorios). Usa UNA opción:
# a) API HTTPS (recomendada; obligatoria en Railway Hobby, que bloquea SMTP)
RESEND_API_KEY=
# BREVO_API_KEY=
# b) SMTP
EMAIL_HOST=smtp.proveedor.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=notificaciones@tudominio.com
EMAIL_PASSWORD=CONTRASENA_DE_APLICACION
EMAIL_FROM="Reservas <notificaciones@tudominio.com>"

# barberías; la plantilla recibe el nombre de cada barbería como parámetro.
