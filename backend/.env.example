PORT=3000
# En producción usa "production", FRONTEND_URL con https y un certificado HTTPS.
# La sesión se almacena en una cookie HttpOnly; Secure se activa automáticamente en producción.
NODE_ENV=development
# Actívalo únicamente detrás de un proxy HTTPS confiable (Nginx, Render, etc.).
TRUST_PROXY=false
# PostgreSQL local de desarrollo (en producción, Supabase: ver docs/DEPLOY_RAILWAY.md).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_SSL=false
# Barbería que atienden las rutas antiguas /api/... (sin /t/:slug) durante la transición SaaS.
DEFAULT_TENANT_SLUG=empyrean-studio
# Marca de correos enviados fuera de una barbería (p. ej. recuperar contraseña sin slug).
PLATFORM_NAME=Reservas de barbería
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASSWORD=tu-contrasena-de-aplicacion
EMAIL_FROM="Empyrean Studio <tu-correo@gmail.com>"

# Para recordatorios reales usa una plantilla aprobada con cinco variables y pon uses_parameters en true.

